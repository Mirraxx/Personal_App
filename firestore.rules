rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Administrador: el único que puede dar o quitar accesos. Si cambias el correo, cámbialo también en index.html.
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email.lower() == 'israllaire@gmail.com';
    }

    // Tiene acceso el administrador y los correos agregados en la colección "allowed".
    function isAllowed() {
      return isAdmin()
        || (request.auth != null
            && request.auth.token.email_verified == true
            && exists(/databases/$(database)/documents/allowed/$(request.auth.token.email.lower())));
    }

    // Datos de cada persona: solo su dueño, y solo si su correo tiene acceso.
    match /users/{uid} {
      allow read, delete: if isAllowed() && request.auth.uid == uid;
      allow create, update: if isAllowed() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['data', 'updatedAt'])
        && request.resource.data.data is string
        && request.resource.data.data.size() < 900000
        && request.resource.data.updatedAt is number;
    }

    // Página de regalo (carpeta regalo/). Todo el contenido se cifra en el navegador con la contraseña del regalo,
    // así que cualquiera puede leer los documentos pero solo se entienden con esa contraseña. Solo el administrador escribe.
    match /gift/{doc} {
      allow read: if true;
      allow create, update: if isAdmin() && doc == 'config'
        && request.resource.data.keys().hasOnly(['v', 'salt', 'iter', 'hint', 'hint2', 'wiv', 'wct', 'iv', 'ct', 'updatedAt'])
        && request.resource.data.ct is string && request.resource.data.ct.size() < 900000
        && request.resource.data.hint is string && request.resource.data.hint.size() < 300
        && request.resource.data.hint2 is string && request.resource.data.hint2.size() < 300;
      allow delete: if isAdmin();
    }

    match /giftPhotos/{id} {
      allow read: if true;
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly(['iv', 'ct', 'updatedAt'])
        && request.resource.data.ct is string && request.resource.data.ct.size() < 900000;
      allow delete: if isAdmin();
    }

    // Aperturas del regalo: quien lo abre deja una marca de hora; solo el administrador las lee.
    match /giftVisits/{id} {
      allow create: if request.resource.data.keys().hasOnly(['t']) && request.resource.data.t is number;
      allow read, delete: if isAdmin();
    }

    // Lista de correos con acceso. Id del documento = correo en minúsculas.
    match /allowed/{mail} {
      allow read: if isAdmin();
      allow get: if request.auth != null && request.auth.token.email.lower() == mail;
      allow create, update: if isAdmin()
        && mail == mail.lower()
        && request.resource.data.keys().hasOnly(['email', 'addedAt', 'addedBy'])
        && request.resource.data.email == mail;
      allow delete: if isAdmin();
    }
  }
}
